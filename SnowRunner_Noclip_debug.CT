if syntaxcheck then return end
local function autoUntick()
  if memrec then
    local mr = memrec
    local t = createTimer(nil, false)
    t.Interval = 1
    t.OnTimer = function(timer)
      timer.destroy()
      if mr then mr.Active = false end
    end
    t.Enabled = true
  end
end
print('Get latest version of this tool here:')
print('https://github.com/FindMuck/CE_RTTI_Reverse_Lookup')
beep()
autoUntick()
{$asm}

